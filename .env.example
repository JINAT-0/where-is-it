# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=where_is_it_db
DB_SSL=false

# Session & Security
SESSION_SECRET=replace_with_a_long_random_64_character_secret_string_here
CSRF_SECRET=replace_with_another_long_random_secret_string_here

# CORS & URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# Frontend Vite Variable (mirror in frontend/.env for Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1

